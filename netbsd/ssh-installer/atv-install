#!/bin/sh
# Install NetBSD on the Apple TV's internal disk.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

bold='' cyan='' yellow='' reset=''
if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
    bold=$(printf '\033[1m')
    cyan=$(printf '\033[36m')
    yellow=$(printf '\033[33m')
    reset=$(printf '\033[0m')
fi

printf '\n%s%s  APPLE TV  /  NETBSD INSTALLER%s\n' "$bold" "$cyan" "$reset"
printf '  ------------------------------------------------\n'
printf '  Target     Internal Apple TV disk (wd0)\n'
printf '  %s%sWARNING    All data on the internal disk will be erased.%s\n\n' "$bold" "$yellow" "$reset"
if [ "$#" -gt 0 ]; then
    printf '  Usage      atv-install\n\n'
    [ "$#" -eq 1 ] && [ "$1" = --help ] && exit 0
    exit 2
fi

printf '  Checking the disk and installation files...\n\n'
mkdir -p /var/db/atv-installer
exec /usr/atv-installer/bin/install.sh wd0 /usr/atv-installer /var/db/atv-installer
